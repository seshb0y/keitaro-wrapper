# Адрес трекера и API-ключ (Профиль → API ключи в админке Keitaro)
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=

# База для своих данных (кампании, созданные через обёртку; закрепления и удалённые офферы)
DATABASE_URL=sqlite:///./keitaro_wrapper.db

# Префикс имён кампаний: обёртка добавит его, если его нет
CAMPAIGN_PREFIX=test_ivanov_

# Значения по умолчанию для новой кампании (пусто — выбрать в форме)
DEFAULT_GROUP_ID=9799
DEFAULT_DOMAIN_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

# Куда первый поток отправляет трафик из выбранных стран
GEO_REDIRECT_URL=https://google.com
